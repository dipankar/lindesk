#!/bin/sh
# lindesk-telemetry prerm: stop the maintenance timer.
set -e

if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
	if [ -d /run/systemd/system ]; then
		if command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke stop lindesk-compact.timer lindesk-compact.service >/dev/null || true
		else
			systemctl stop lindesk-compact.timer lindesk-compact.service >/dev/null 2>&1 || true
		fi
	fi
fi

exit 0
