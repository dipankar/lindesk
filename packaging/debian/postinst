#!/bin/sh
# lindesk postinst: group, state dirs, requirement check, enable and (re)start services.
# Works without systemd as PID 1 (containers, chroots, sysvinit): every systemctl call
# is either offline-safe (enable) or guarded by /run/systemd/system.
# The requirement check (lindeskctl doctor --preflight) never fails the transaction: on a
# hard failure lindeskd is installed and enabled but not started.
set -e

SYSTEM_UNITS="lindeskd.service"
USER_UNITS="lindesk-session.service"

LIB_DIR=${LINDESK_LIB_DIR:-/var/lib/lindesk}
CONFLICT_UNITS="com.system76.Scheduler.service system76-scheduler.service ananicy-cpp.service ananicy.service uresourced.service"

# turned_off: `lindeskctl off` recorded that lindesk must stay off (upgrades included).
turned_off() {
	grep -q '"lindesk_enabled": false' "$LIB_DIR/install-state.json" 2>/dev/null
}

# conflicts: never disable anything from a package script; print the command instead.
conflicts() {
	command -v systemctl >/dev/null 2>&1 || return 0
	_found=
	for _u in $CONFLICT_UNITS; do
		if systemctl is-active --quiet "$_u" 2>/dev/null || systemctl is-enabled --quiet "$_u" 2>/dev/null; then
			_found="$_found $_u"
		fi
	done
	[ -n "$_found" ] || return 0
	echo "lindesk: conflicting priority daemon(s) active:$_found"
	echo "lindesk:   they re-prioritise processes too and will fight lindesk. Disable them (revertible):"
	echo "lindesk:   sudo lindeskctl setup conflicts --disable"
	return 0
}

# tmo CMD...: run with a 15 s timeout when timeout(1) exists.
tmo() { if command -v timeout >/dev/null 2>&1; then timeout 15 "$@"; else "$@"; fi; }

# start_sessions: start lindesk-session for every user logged in to a

# graphical session, through their user manager, so nobody has to log out.

# Best effort, never fatal.
start_sessions() {
	command -v loginctl >/dev/null 2>&1 || return 0
	[ -d /run/systemd/system ] || return 0
	for _sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{ print $1 }'); do
		_type=$(loginctl show-session "$_sid" -p Type --value 2>/dev/null) || continue
		case $_type in wayland | x11) ;; *) continue ;; esac
		loginctl show-session "$_sid" -p Name --value 2>/dev/null
	done | sort -u | while read -r _u; do
		[ -n "$_u" ] || continue
		tmo systemctl --user -M "$_u@" daemon-reload >/dev/null 2>&1 || true
		# restart (not start) so an upgrade moves a running agent onto the new binary
		if tmo systemctl --user -M "$_u@" restart lindesk-session.service >/dev/null 2>&1; then
			echo "lindesk: started lindesk-session for $_u"
		fi
	done
	return 0
}

# preflight: 0 = requirements met (or the check is unavailable), 1 = a hard failure.
preflight() {
	[ -z "$DPKG_ROOT" ] && [ -x /usr/bin/lindeskctl ] || return 0
	rc=0
	if command -v timeout >/dev/null 2>&1; then
		out=$(timeout 30 /usr/bin/lindeskctl doctor --preflight --quiet 2>&1 </dev/null) || rc=$?
	else
		out=$(/usr/bin/lindeskctl doctor --preflight --quiet 2>&1 </dev/null) || rc=$?
	fi
	[ "$rc" -eq 1 ] || return 0
	{
		echo "lindesk: WARNING: this system does not meet lindesk's requirements:"
		[ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/lindesk:   /'
		echo "lindesk: lindeskd was installed but NOT started. Fix the failures, check with"
		echo "lindesk:   lindeskctl doctor --preflight"
		echo "lindesk: then start it:  systemctl start lindeskd.service"
	} >&2
	return 1
}

case "$1" in
configure | abort-upgrade | abort-deconfigure | abort-remove)
	if command -v systemd-sysusers >/dev/null 2>&1; then
		systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} lindesk.conf || true
	elif ! getent group lindesk >/dev/null 2>&1; then
		addgroup --system lindesk >/dev/null || true
	fi
	if command -v systemd-tmpfiles >/dev/null 2>&1; then
		systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create lindesk.conf || true
	fi

	for unit in $SYSTEM_UNITS; do
		if command -v deb-systemd-helper >/dev/null 2>&1; then
			# Remove masks created on removal; respect an admin's earlier "disable".
			deb-systemd-helper unmask "$unit" >/dev/null || true
			if deb-systemd-helper --quiet was-enabled "$unit"; then
				deb-systemd-helper enable "$unit" >/dev/null || true
			else
				deb-systemd-helper update-state "$unit" >/dev/null || true
			fi
		elif command -v systemctl >/dev/null 2>&1; then
			systemctl enable "$unit" >/dev/null 2>&1 || true
		fi
	done
	if [ -z "$2" ] && command -v systemctl >/dev/null 2>&1; then
		# Fresh install: enable the session agent for every user.
		# shellcheck disable=SC2086
		systemctl --global enable $USER_UNITS >/dev/null 2>&1 || true
	fi

	# The pre-lindesk state of conflicting daemons, kept from the first install on.
	if [ -z "$DPKG_ROOT" ] && [ -x /usr/bin/lindeskctl ]; then
		tmo /usr/bin/lindeskctl setup snapshot --method deb >/dev/null 2>&1 || true
	fi

	ok=1
	preflight || ok=0
	if turned_off; then
		ok=0
		echo "lindesk: lindesk was turned off with 'lindeskctl off'; leaving it off (turn it on: lindeskctl on)"
	fi

	if [ -d /run/systemd/system ] && [ "$ok" -eq 0 ]; then
		systemctl --system daemon-reload >/dev/null || true
	elif [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		# Upgrade: restart rather than try-restart. We only get here when lindesk is enabled
		# (not turned off), and a broker that had died must come back on the new binary.
		if [ -n "$2" ]; then action=restart; else action=start; fi
		# shellcheck disable=SC2086
		if command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke $action $SYSTEM_UNITS >/dev/null || true
		else
			systemctl $action $SYSTEM_UNITS >/dev/null || true
		fi
		start_sessions
		echo "lindesk: lindeskd is running; lindesk-session runs in every graphical session."
	else
		echo "lindesk: systemd is not running; services enabled but not started."
		echo "lindesk: without systemd, lindesk-session starts from /etc/xdg/autostart."
	fi
	turned_off || conflicts
	if [ -z "$2" ]; then
		echo "lindesk: what now: 'lindeskctl' shows what lindesk is doing, 'lindeskctl watch' follows it live,"
		echo "lindesk:   'lindeskctl doctor' shows what this machine supports."
		echo "lindesk: GNOME: lindesk-session enables its Shell extension on first start; if it stays off:"
		echo "lindesk:   gnome-extensions enable lindesk@lindesk.org   (on Wayland, log out and back in first)"
		echo "lindesk: KDE: enable 'lindesk' in System Settings > Window Management > KWin Scripts"
		echo "lindesk: AI agents (MCP): claude mcp add lindesk -- lindesk-mcp"
		if [ ! -x /usr/bin/lindesk-data ]; then
			echo "lindesk: telemetry (SQL over what lindesk records) is optional: apt install lindesk-telemetry"
		fi
	fi
	;;
esac

exit 0
