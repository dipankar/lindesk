#!/bin/sh
# lindesk prerm: stop the services and undo every runtime change before the binaries go.
set -e

if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
	if [ -d /run/systemd/system ]; then
		if command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke stop lindeskd.service >/dev/null || true
		else
			systemctl stop lindeskd.service >/dev/null 2>&1 || true
		fi
	fi
	# Stop everything and restore what lindesk changed: cgroup settings and iocost,
	# every versioned change (sysctls, schedulers, services it disabled), drop-ins and
	# desktop integration. Conflicting daemons changed by hand are left as they are.
	if [ -x /usr/share/lindesk/uninstall.sh ]; then
		/usr/share/lindesk/uninstall.sh --restore-only --yes --keep-current ||
			echo "lindesk: warning: some changes could not be restored (see above)" >&2
	elif [ -x /usr/bin/lindeskd ]; then
		/usr/bin/lindeskd --restore >/dev/null 2>&1 || echo "lindesk: warning: lindeskd --restore failed" >&2
	fi
fi

exit 0
