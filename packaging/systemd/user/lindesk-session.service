[Unit]
Description=lindesk session agent (foreground tracking and per-user QoS)
Documentation=man:lindesk-session(1) https://github.com/dipankar/lindesk
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.lindesk.QoS1
ExecStart=/usr/bin/lindesk-session
# SIGHUP re-reads the config and loads newly installed plugins (e.g. lindesk-telemetry).
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/usr/bin/lindesk-session --restore
Restart=on-failure
RestartSec=2s
Slice=session.slice
# Guaranteed minimum for the agent itself (see lindeskd.service): a high share when
# contended, a working set that is neither reclaimed nor swapped, pages locked in RAM.
CPUWeight=500
IOWeight=500
MemoryMin=24M
MemoryLow=48M
MemorySwapMax=0
LimitMEMLOCK=infinity

[Install]
WantedBy=graphical-session.target
