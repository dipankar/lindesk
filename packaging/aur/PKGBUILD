# Maintainer: Dipankar Sarkar <me@dipankar.name>
#
# AUR split package: lindesk (the core: no DuckDB or Vortex) and lindesk-telemetry (the
# telemetry lake: lindesk-data, the telemetry plugin, the compaction timers). The installed
# layout comes from packaging/install.sh (--without-telemetry / --telemetry-only).
#
# Release checklist:
#   1. bump pkgver (it must match [workspace.package] version in Cargo.toml), reset pkgrel
#   2. updpkgsums                              # replaces the SKIP checksum
#   3. makepkg --printsrcinfo > .SRCINFO       # the AUR requires .SRCINFO to match
#   4. namcap PKGBUILD && makepkg -sf && namcap lindesk-*.pkg.tar.zst
#   5. git add PKGBUILD .SRCINFO lindesk.install lindesk-telemetry.install && git commit && git push
# Without an Arch host: packaging/build-packages.sh arch (also refreshes dist/.SRCINFO).

pkgbase=lindesk
pkgname=(lindesk lindesk-telemetry)
pkgver=0.1.0
pkgrel=1
pkgdesc='macOS-style QoS for the Linux desktop: a plugin-based userspace resource governor'
arch=(x86_64 aarch64)
url='https://github.com/dipankar/lindesk'
license=('MIT OR Apache-2.0' 'GPL-3.0-only')  # GPL: lindesk-session links cosmic-protocols
makedepends=(cargo)
options=(!lto !debug)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_bins=(lindeskd lindesk-session lindeskctl lindesk-bench lindesk-mcp lindesk-data lindesk-telemetry-sink)

prepare() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  local _p=()
  for b in "${_bins[@]}"; do _p+=(-p "$b"); done
  cargo build --frozen --release "${_p[@]}"
}

check() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace --lib
}

package_lindesk() {
  depends=(dbus polkit systemd gcc-libs glibc)
  optdepends=(
    'lindesk-telemetry: telemetry lake, lindeskctl query/data/simulate'
    'gnome-shell: GNOME foreground adapter (extension lindesk@lindesk.org)'
    'kwin: KDE Plasma foreground adapter (KWin script)'
    'hyprland: Hyprland foreground adapter (built in; Omarchy)'
  )
  backup=(etc/lindesk/lindesk.toml)
  install=lindesk.install
  cd "$pkgbase-$pkgver"
  CARGO_TARGET_DIR=target ./packaging/install.sh --destdir="$pkgdir" --prefix=/usr --sysconfdir=/etc \
    --no-build --no-enable --no-manifest --without-telemetry
}

package_lindesk-telemetry() {
  pkgdesc='Telemetry lake for lindesk: DuckDB-queryable Vortex lake, its writer plugin and maintenance timers'
  depends=("lindesk=$pkgver" gcc-libs glibc)
  optdepends=('duckdb: query the telemetry lake from the DuckDB CLI')
  install=lindesk-telemetry.install
  cd "$pkgbase-$pkgver"
  CARGO_TARGET_DIR=target ./packaging/install.sh --destdir="$pkgdir" --prefix=/usr --sysconfdir=/etc \
    --no-build --no-enable --no-manifest --telemetry-only
}
